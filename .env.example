# ─── Base de données ────────────────────────────────────────────────
# Postgres local via docker-compose (voir docker-compose.yml)
DATABASE_URL="postgresql://invoiceflow:invoiceflow@localhost:5432/invoiceflow"
# Base dédiée aux tests d'intégration (peut pointer sur la même instance)
TEST_DATABASE_URL="postgresql://invoiceflow:invoiceflow@localhost:5432/invoiceflow_test"

# ─── Auth (Better Auth) ─────────────────────────────────────────────
# openssl rand -base64 32
BETTER_AUTH_SECRET="change-me-with-a-32-byte-random-secret"
BETTER_AUTH_URL="http://localhost:3000"

# ─── Application ────────────────────────────────────────────────────
APP_URL="http://localhost:3000"

# ─── Emails (Resend) ────────────────────────────────────────────────
# Laisser vide en dev : les emails sont écrits dans .storage/emails/*.html
RESEND_API_KEY=""
RESEND_WEBHOOK_SECRET=""
EMAIL_FROM="Daromsart Système <no-reply@example.com>"

# ─── Stockage de fichiers ───────────────────────────────────────────
# fs (dev, écrit dans .storage/) | s3 (prod, S3/R2-compatible)
STORAGE_DRIVER="fs"
STORAGE_BUCKET=""
STORAGE_ENDPOINT=""
STORAGE_REGION="auto"
STORAGE_ACCESS_KEY_ID=""
STORAGE_SECRET_ACCESS_KEY=""
STORAGE_PUBLIC_URL=""

# ─── Seed (compte admin initial) ────────────────────────────────────
SEED_ADMIN_EMAIL="admin@daromsart.test"
SEED_ADMIN_PASSWORD="Admin1234!"

# ─── Worker Python (services/python-worker) ─────────────────────────
# Clé requise en en-tête `X-API-Key` pour appeler l'API du worker.
# Vide en dev = authentification désactivée. Toujours la renseigner en prod.
WORKER_API_KEY=""

# ─── Copilote agent (mode agent, API Claude) ────────────────────────
# Vide = mode agent désactivé (la route de chat renvoie une erreur lisible).
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=""
