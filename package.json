{
  "name": "daromsart-agency",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@9.7.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "turbo run dev",
    "start:invoiceflow": "pnpm --filter @daromsart/invoiceflow-ai dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "e2e": "playwright test",
    "docker:dev": "docker compose up -d",
    "docker:dev:down": "docker compose down",
    "docker:prod": "docker compose -f docker-compose.prod.yml up -d --build",
    "docker:prod:down": "docker compose -f docker-compose.prod.yml down",
    "docker:build:invoiceflow": "docker build -f apps/invoiceflow-ai/Dockerfile -t daromsart/invoiceflow-ai:latest .",
    "format": "prettier --write \"**/*.{ts,tsx,css,md,json}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,css,md,json}\""
  },
  "devDependencies": {
    "@playwright/test": "1.47.0",
    "dotenv": "16.4.5",
    "drizzle-orm": "0.36.4",
    "postgres": "3.4.5",
    "prettier": "3.3.3",
    "turbo": "2.1.3",
    "typescript": "5.5.4"
  }
}
